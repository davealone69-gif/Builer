# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# HUGGINGFACE_API_KEY: Optional user token for Hugging Face Inference API calls.
HUGGINGFACE_API_KEY=MY_HUGGINGFACE_API_KEY

# OPENROUTER_API_KEY: Required for OpenRouter multi-model AI API calls.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# OLLAMA_API_KEY: Optional API key/auth token for secured Ollama endpoints.
OLLAMA_API_KEY=MY_OLLAMA_API_KEY

# OLLAMA_HOST: Default local or remote Ollama service endpoint.
OLLAMA_HOST=http://10.0.2.2:11434

# X_API_KEY: Custom HTTP X-API-KEY header token for custom backend services.
X_API_KEY=MY_X_API_KEY
